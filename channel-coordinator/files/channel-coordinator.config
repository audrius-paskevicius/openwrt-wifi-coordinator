config coordinator 'main'
 option enabled '1'
 option mode 'automatic'
 option interval '60'
 option improvement '3'
 option min_dwell '180'
 option retry_delay '30'
 option scan_duty '10'
 option radar_half_life '21600'
 option overlap_penalty '25'
 option separate_radios '1'
 option wide_threshold '70'
 option max_mbps '0.05'
 option quiet_seconds '60'
 option handoff_wait '90'
 option handoff_escalation 'decisive'
 option allow_reconnect '1'
 option ban_seconds '20'
 option handoff_target_min '-72'
 option handoff_source_min '-65'
 option history_enabled '1'
 option history_hours '24'
 option dfs_mode 'prepare'
 option dfs_helper ''
 option cac_timeout '720'
 option scan_policy 'paced'
 option scan_gap '3'
 option scan_wait '60'
 option scan_type 'active'
 option scan_batch '5'
 option scanner ''
 option max_age '900'
 option persist '1'
 option csa_count '15'

# Radio sections are optional; defaults are discovered from the live hardware.
# 2.4 GHz: channels 1-13, width 20; regulatory rules remove unavailable channels.
# 5 GHz compares 80/40/20 MHz, including DFS with matching ETSI regions and CAC.
# Per-radio occupied_policy: empty, quiet, or handoff (default).
# handoff uses live CSA, or evacuates clients before a required restart.
# idle_reconfigure still requires an empty radio; it never restarts clients.
