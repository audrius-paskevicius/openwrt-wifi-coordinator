config coordinator 'main'
 option enabled '1'
 option mode 'automatic'
 option interval '60'
 option improvement '3'
 option min_dwell '180'
 option scan_duty '10'
 option radar_half_life '3600'
 option overlap_penalty '25'
 option separate_radios '1'
 option max_mbps '0.05'
 option quiet_seconds '60'
 option handoff_wait '90'
 option handoff_escalation 'decisive'
 option allow_reconnect '1'
 option handoff_target_min '-72'
 option handoff_source_min '-65'
 option history_enabled '1'
 option history_hours '24'
 option history_save_minutes '360'
 option dfs_mode 'prepare'
 option dfs_helper ''
 option scan_policy 'paced'
 option scan_gap '3'
 option scan_type 'active'
 option scanner ''
 option max_age '900'
 option persist '1'

# Radio sections are optional; defaults are discovered from the live hardware.
# channels 'auto' follows each driver's enabled channels in the configured band.
# Explicit space-separated lists remain available. All regulatory checks apply.
# Width auto follows live HT/VHT capabilities: up to 40 MHz on 2.4 GHz,
# up to 160 MHz on 5 GHz, with coexistence, regulatory and DFS checks.
# Per-radio occupied_policy: empty, quiet, or handoff (default).
# handoff uses live CSA, or tries a compatible handoff before a required restart.
# allow_reconnect permits an occupied restart if handoff cannot finish.
# Protected clients and explicit quiet/empty policies still restrict restarts.
