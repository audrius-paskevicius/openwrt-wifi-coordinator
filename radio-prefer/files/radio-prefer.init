#!/bin/sh /etc/rc.common
# Compatibility entry point; the coordinator owns the only control loop.
START=49
STOP=10
start() { /etc/init.d/channel-coordinator start; }
stop() { /etc/init.d/channel-coordinator stop; }
restart() { /etc/init.d/channel-coordinator restart; }
reload() { /etc/init.d/channel-coordinator reload; }
status() { /etc/init.d/channel-coordinator status; }
