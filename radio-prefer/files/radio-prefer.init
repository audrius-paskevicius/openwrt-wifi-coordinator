#!/bin/sh /etc/rc.common
START=49
STOP=10
USE_PROCD=1

start_service() {
	[ ! -f /usr/share/channel-coordinator/defaults.uc ] || /usr/bin/ucode /usr/share/channel-coordinator/defaults.uc --apply
	[ "$(uci -q get radio_prefer.main.enabled)" = 1 ] || return 0
	/usr/bin/ucode /usr/share/radio-prefer/coordination.uc --prepare || return 1
	# Persist the handover before usteer starts at boot; reload a live instance.
	if /etc/init.d/usteer running; then /etc/init.d/usteer reload; fi
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/radio-prefer/main.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_stopped() {
	# rc.common invokes this after terminating our process, avoiding restore races.
	/usr/bin/ucode /usr/share/radio-prefer/coordination.uc --restore || return 1
	if /etc/init.d/usteer running; then /etc/init.d/usteer reload; fi
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger radio_prefer wireless
}
