#!/bin/sh
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
pids=$(ubus call service list | /usr/bin/ucode -e 'let s=json(require("fs").stdin.read("all"));for(let n in ["channel-coordinator","radio-prefer"])for(let i in values(s[n]?.instances ?? {}))if(i.running&&i.pid>0)print(i.pid+" ");')
for svc in channel-coordinator radio-prefer; do
 if ubus call service list "{\"name\":\"$svc\"}" | /usr/bin/ucode -e 'import * as fs from "fs"; exit(length(json(fs.stdin.read("all"))) ? 0 : 1);'; then
  /etc/init.d/$svc stop
 elif [ "$svc" = channel-coordinator ]; then
  /usr/bin/ucode /usr/share/channel-coordinator/main.uc --recover
 fi
done
waited=0
while [ "$waited" -lt 20 ]; do
 alive=0
 for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
 [ "$alive" = 1 ] || break
 sleep 1
 waited=$((waited + 1))
done
[ "$alive" != 1 ] || { echo 'Controller did not stop; upgrade deferred.' >&2; exit 1; }
exit 0
