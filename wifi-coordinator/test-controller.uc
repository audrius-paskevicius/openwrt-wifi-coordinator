import {reservations,movement_cost,action_valid,return_summary,create_returns,width_retry} from '../channel-coordinator/files/controller.uc';
import {choose,decide} from '../channel-coordinator/files/planner.uc';
import {group} from '../channel-coordinator/files/policy.uc';
let count=0;
function check(v,label){if(!v)die('FAIL: '+label+'\n');count++;}
let g=group(5600,160),other=group(5620,160),far=group(5180,160);
let m={current:g,clients:2,config:{method:'idle_reconfigure'}};
check(movement_cost(m,g,{improvement:3})==0,'incumbent has no move cost');
check(movement_cost(m,other,{improvement:3})>movement_cost(m,far,{improvement:3}),'same block primary restart needs more benefit');
check(movement_cost(m,far,{improvement:3})>movement_cost({...m,clients:0},far,{improvement:3}),'occupied restart costs more than empty move');
check(movement_cost(m,far,{improvement:3})>movement_cost({...m,config:{method:'csa'}},far,{improvement:3}),'working CSA costs less than restart');
check(sprintf('%J',reservations({radio:'legacy'}))=='[ "legacy" ]','legacy change does not reserve good or broad radio');
check(length(reservations({radio:'good',helper:{name:'broad'},handoff_target:'broad'}))==2,'shared helper reserved once');
check(length(reservations(null))==0,'idle reserves nothing');
let action={source:g,fingerprint:'a',evidence_at:10};
check(action_valid(action,{current:g,fingerprint:'a'},20,30),'fresh action valid');
check(!action_valid(action,{current:far,fingerprint:'a'},20,30),'unexpected placement invalidates action');
check(!action_valid(action,{current:g,fingerprint:'b'},20,30),'administrator edits invalidate action');
check(!action_valid(action,{current:g,fingerprint:'a'},41,30),'stale evidence invalidates action');
let before={a:true,b:true,c:true},radios=[{name:'good',authorized:{a:{}}},{name:'broad',authorized:{b:{}}}];
let result=return_summary(before,radios,'good');
check(result.returned==1&&result.elsewhere==1&&result.absent==1,'service elsewhere is not return; absent client tracked separately');
let t=0,events=[],follow=create_returns({now:()=>t,history:e=>push(events,e)});
follow.add({id:'one',radio:'good',before},'good');follow.tick(radios,{});
check(join(',',follow.radios())=='good','return observation reserves only its preferred radio');
check(events[0].elsewhere==1&&events[0].absent==1,'honest initial outcome');
follow.tick(radios,{});check(length(events)==1,'unchanged status does not blink or flood log');
t=121;follow.tick(radios,{b:{response:7,last_btm:1}});
check(!follow.busy()&&events[-1].declined==1,'bounded return ends despite absent or declining clients');
check(!length(follow.radios()),'return reservation expires even when clients decline');
let retry=width_retry(null,100,900);
check(retry.until==1000,'first width refusal has short evidence deferral');
retry=width_retry(retry,1000,900);check(retry.until==2800,'repeated width refusal backs off');
for(let i=0;i<8;i++)retry=width_retry(retry,retry.until,900);
check(retry.until-retry.at==21600,'width retry is bounded to six hours');
check(width_retry(retry,retry.at+86401,900).attempts==1,'old width failures do not accumulate forever');
let cfg={separate:true,improvement:3},current={...g,cost:20,uncertainty:3},alternative={...other,cost:15,uncertainty:3};
let models=[{...m,name:'good',current,candidates:[current,alternative]}];
check(!length(choose(models,cfg).path),'five-point primary gain cannot justify occupied restart');
models[0].candidates[1].cost=-30;
check(decide(choose(models,cfg),models,null,1,cfg,null).action=='move','clear same-block improvement still acts');
follow.add({id:'two',radio:'good',before:{a:true,b:true},return_before:{a:true}},'good');
follow.tick(radios,{});check(events[-1].total==1&&!follow.busy(),'helper clients are not counted as preferred-radio return failures');
printf('PASS: %d shared controller policy checks\n',count);
